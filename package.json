{
  "name": "pixelpod",
  "productName": "PixelPod",
  "description": "A premium desktop Spotify player with a nostalgic iPod soul.",
  "author": "PixelPod contributors",
  "license": "MIT",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c magenta,cyan \"vite\" \"wait-on tcp:127.0.0.1:5174 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 node scripts/launch-electron.mjs\"",
    "dev:renderer": "vite",
    "build": "vite build",
    "start": "node scripts/launch-electron.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/ electron/",
    "format": "prettier --write src/ electron/",
    "icons": "node scripts/generate-icons.mjs",
    "pack": "vite build && electron-builder --dir",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "lucide-react": "^1.68.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "github:castlabs/electron-releases#v44.10.1+wvcus",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.4",
    "vite": "^5.2.0",
    "vitest": "^4.1.0",
    "wait-on": "^9.5.1"
  }
}
