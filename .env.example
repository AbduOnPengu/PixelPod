# PixelPod Desktop — Development Environment (Optional)
#
# PixelPod uses OAuth 2.0 Authorization Code with PKCE (no Client Secret needed!).
# You can either paste your Spotify Client ID directly inside PixelPod's login/settings
# screen, or set it below for local development.
#
# Spotify Developer Dashboard setup (https://developer.spotify.com/dashboard):
#   1. Create an app (or open an existing one).
#   2. Add this exact Redirect URI:
#        http://127.0.0.1:43821/callback
#   3. Copy the 32-character Client ID (never use the Client Secret).

SPOTIFY_CLIENT_ID=

# Optional: override the local loopback port used during OAuth login (default: 43821)
# PIXELPOD_OAUTH_PORT=43821
